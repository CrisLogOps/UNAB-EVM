# --- Postgres local (Docker, puerto 54322 = convención Supabase CLI) ---
# Para el proyecto hosted, reemplazar por la URI de Settings → Database.
SUPABASE_URL=http://localhost:54322
SUPABASE_ANON_KEY=local-anon-not-used
SUPABASE_SERVICE_ROLE_KEY=local-service-not-used
DATABASE_URL=postgresql://postgres:openevm@localhost:54322/postgres
MVP_TENANT_ID=mvp-demo

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
JWT_SECRET=change_me_in_production
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# --- Frontend ---
API_BASE_URL=http://localhost:8000
STREAMLIT_SERVER_PORT=8501
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Storage (evidencias) ---
EVIDENCE_BUCKET=project-evidence
